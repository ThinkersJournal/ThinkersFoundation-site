---
import { NAV } from '../consts';
import Wordmark from './Wordmark.astro';
---
<header class="nav">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Thinker's Foundation home"><Wordmark /></a>
    <nav class="links" aria-label="Primary">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>
<style>
  .nav{border-bottom:1px solid var(--line)}
  .bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px 18px;min-height:66px;padding-top:8px;padding-bottom:8px}
  .links{display:flex;gap:22px;font-size:15px;color:var(--muted)}
  .links a{padding:10px 0}
  .links a:hover{color:var(--text)}
</style>
